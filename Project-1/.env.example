# ==============================================================================
# Markly - Cloud Bookmarks Workspace with Supabase Realtime Sync
# ==============================================================================

# Supabase Cloud Configuration (Required for Cloud Database & Multi-Tenant Auth)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# Supabase Service Role Key (Server-side operations only - never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Local fallback database mode (optional)
DATABASE_MODE=sqlite
DATABASE_SQLITE_PATH=./data/markly.db

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
